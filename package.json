{
  "name": "fuse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "e2e": "vitest run --config e2e/vitest.config.ts",
    "test:watch": "vitest",
    "tauri": "tauri",
    "check": "bash scripts/check.sh",
    "record-fixtures": "node scripts/record-fixtures.ts",
    "continuity:live": "vitest run --mode continuity src/context/continuity.live.test.ts",
    "coding:live": "vitest run --mode coding src/agent/coding.live.test.ts",
    "work:live": "vitest run --mode work src/agent/work.live.test.ts",
    "local:bench": "vitest run --mode localbench src/local/local.bench.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "fflate": "^0.8.3",
    "jspdf": "4.2.1",
    "katex": "0.16.47",
    "lucide-react": "^1.61.0",
    "mermaid": "12.1.0",
    "pdfjs-dist": "6.4.299",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "6.0.0",
    "sucrase": "3.35.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
